    "@holy-padel/scoring": "workspace:*",
    "@tamagui/config": "2.4.1",
    "expo": "~57.0.2",
    "expo-build-properties": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-file-system": "^57.0.6",
    "expo-font": "~57.0.0",
    "expo-haptics": "^57.0.2",
    "expo-linking": "~57.0.1",
    "expo-router": "~57.0.3",
    "expo-sharing": "^57.0.16",
    "expo-splash-screen": "~57.0.2",
