{
  "expo": {
    "name": "Holy Padel",
    "slug": "holy-padel",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "holy-padel",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F1F0EA",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.holypadel.app",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "NSHealthUpdateUsageDescription": "Holy Padel saves your finished matches to Apple Health as workouts.",
        "NSHealthShareUsageDescription": "The Holy Padel watch app reads your heart rate during a match to show it on the scoreboard."
      }
    },
    "android": {
      "package": "com.holypadel.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E1116",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_HEART_RATE",
        "android.permission.health.WRITE_TOTAL_CALORIES_BURNED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E1116",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 104
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/with-health-connect.js",
      "./plugins/with-gradle-perf.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
